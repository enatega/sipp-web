# Server-only upstream API URL. Never expose this as NEXT_PUBLIC_*.
SHAANIEOL_API_BASE_URL=http://localhost:3000/api/v1

# Server-only HMAC secret for short-lived forgot-password grants (32+ characters).
SHAANIEOL_PASSWORD_RESET_SECRET=

# Used by the server-side Google Maps proxy.
GOOGLE_MAPS_API_KEY=

# Browser-restricted Google Maps key used by the interactive address picker.
# Match Shaanieol-admin and restrict allowed referrers for deployed domains.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Browser-restricted Stripe publishable key. Card data is collected by Stripe Elements.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Public OAuth identifier. Restrict it to the deployed web origins.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
